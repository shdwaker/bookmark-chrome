{
  "manifest_version": 3,
  "name": "MarkTrace",
  "version": "1.0.0",
  "description": "书签管理 + 访问留痕 + AI翻译 + 页签清理，替换 Chrome 新标签页，打造高效浏览工作区",
  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "history",
    "alarms",
    "contextMenus"
  ],
  "action": {
    "default_title": "打开 MarkTrace",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "32": "public/icons/icon32.png"
    }
  },
  "host_permissions": [
    "https://dashscope.aliyuncs.com/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.moonshot.cn/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/translate-panel.js-loader-dEAvXDUY.js",
        "assets/inline-translate.js-loader-ChjC3kHS.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "chrome_url_overrides": {
    "newtab": "src/pages/main/index.html"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "src/pages/main/index.html",
        "src/pages/settings/index.html",
        "assets/inline-translate.js-BgsM6hzZ.js",
        "assets/translate-panel.js-IETFeqhk.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
